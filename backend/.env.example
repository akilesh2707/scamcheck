# ==========================================
# ScamCheck Backend - Environment Configuration
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# PORT: The port the Express server will listen on. (Default: 5001)
# NODE_ENV: 'development' or 'production' (Required in production)
# In production, missing secrets will cause the app to crash on boot.
PORT=5001
NODE_ENV=development

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# MONGODB_URI: Connection string for MongoDB. (Required)
# Safe Example (Docker internal): mongodb://mongodb:27017/scamcheck
MONGODB_URI=mongodb://localhost:27017/scamcheck_dev

# REDIS_URL: Connection string for Redis. (Required)
# Redis is transient cache/pairing, but loss will log out extensions.
# Safe Example (Docker internal): redis://redis:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Service Dependencies
# ------------------------------------------
# ML_SERVICE_URL: URL to the ML Python Service. (Required)
# Safe Example (Docker internal): http://ml-service:8000
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------
# Security & Authentication (SECRETS)
# ------------------------------------------
# JWT_SECRET: Cryptographic secret used to sign JWTs. (Required in production)
# DO NOT bundle this into the frontend or extension!
# Generate a safe random string: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# LLM_API_KEY: Provider API key for LLM operations. (Required)
# This MUST remain server-side.
LLM_API_KEY=your_llm_api_key_here
EMBEDDING_API_KEY=

# ------------------------------------------
# Limits
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100