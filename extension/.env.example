# ==========================================
# ScamCheck Extension - Environment Configuration
# ==========================================

# VITE_SCAMCHECK_API_URL: Base URL of the ScamCheck backend API.
# In production, this must point to the public backend API (e.g., https://api.scamcheck.example.com)
VITE_SCAMCHECK_API_URL=http://localhost:5001

# VITE_WEB_APP_URL: Base URL of the ScamCheck Web application for connection flows.
# In production, this must point to the public frontend (e.g., https://scamcheck.example.com)
VITE_WEB_APP_URL=http://localhost:5173
