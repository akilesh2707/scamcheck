# ==========================================
# ScamCheck ML Service - Environment Configuration
# ==========================================

# ------------------------------------------
# Provider Configuration
# ------------------------------------------
# LLM_PROVIDER: Provider for the language model (e.g., openai, google)
LLM_PROVIDER=openai

# LLM_API_KEY: Provider API key for LLM operations. (Required)
# This MUST remain server-side.
LLM_API_KEY=your_llm_api_key_here

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
# REDIS_URL: Connection string for Redis. (Required)
# Redis is used for caching/queueing.
# Safe Example (Docker internal): redis://redis:6379
REDIS_URL=redis://localhost:6379
